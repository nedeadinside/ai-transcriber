COMPOSE_PROFILES=cpu

HF_TOKEN=
LLM_API_KEY=

DIARIZER_PORT=8001
TRANSCRIBER_PORT=8000
MCP_PORT=8002
WHISPER_PORT=9000

SPOOL_DIR=/data/spool
POOL_DIR=/data/pool
HF_CACHE_DIR=/root/.cache
ASR_MODEL_PATH=/root/.cache/whisper

REDIS_IMAGE=redis:7-alpine
WHISPER_IMAGE=onerahmet/openai-whisper-asr-webservice:v1.9.1
WHISPER_IMAGE_GPU=onerahmet/openai-whisper-asr-webservice:v1.9.1-gpu

ASR_ENGINE=faster_whisper
ASR_MODEL=large-v3
